# YouTube Data API v3 key. Needed for nlm_audit date resolution and watched sources.
# Google Cloud Console > APIs & Services > Credentials > Create API key.
# After creating it, restrict it: API restrictions > YouTube Data API v3 only.
YOUTUBE_API_KEY=

# Optional: directory where the persistent Chrome profile is stored.
# NLM_DATA_DIR=

# Optional: 'chrome' (default) or 'chromium'
# NLM_BROWSER_CHANNEL=chrome

# Optional: minimum ms between nlm_ask question submissions (default 4000)
# NLM_MIN_ASK_INTERVAL_MS=4000

# Optional: account checked in the background when the MCP server starts.
# NLM_STARTUP_ACCOUNT=default

# Optional: delay before the non-blocking startup catch-up (default 1500ms).
# NLM_STARTUP_DELAY_MS=1500
