{
  "name": "notebooklm-curator",
  "version": "0.2.0",
  "description": "MCP server for Gemini Notebook (NotebookLM): watch, add, audit and safely prune sources.",
  "type": "module",
  "bin": {
    "notebooklm-curator": "src/index.js",
    "notebooklm-curator-sync": "src/cli.js"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "sync": "node --env-file=.env src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "patchright": "^1.49.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkancakmakcreative/notebooklm-curator.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notebooklm",
    "gemini-notebook",
    "youtube",
    "source-sync",
    "claude",
    "playwright",
    "browser-automation"
  ]
}
